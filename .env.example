# Copy to .env and fill in. Never commit .env.

# ---- Production (docker compose) ----
# Public domain pointing at the VPS (Caddy gets the HTTPS certificate for it)
DOMAIN=checkin.example.com

# Random string, 32+ chars: openssl rand -hex 32
# Encrypts the saved SMTP password, so do not change it later
APP_SECRET=

# First admin account, created on first start when the database has no users.
# Afterwards, create staff accounts in the app (avatar menu > Tài khoản).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- Optional ----
# Load the README sample events/guests (default: off in production, on in dev)
# SEED_SAMPLE_DATA=false
# Reset-check-in and race-test tools (default: off in production)
# ENABLE_DEMO_TOOLS=false
# Backups kept by scripts/backup.mjs
# BACKUP_KEEP=14

# ---- Gmail SMTP (can also be set in the app: Cài đặt Email SMTP) ----
# Use an App Password (16 chars): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=my_email@gmail.com
SMTP_PASS=
SMTP_FROM=my_email@gmail.com
SMTP_FROM_NAME=Ban Tổ Chức Sự Kiện

# ---- Local development (npm run dev) ----
# PORT=3000
# DB_PATH=./data/checkin.db
# APP_URL=http://localhost:3000
